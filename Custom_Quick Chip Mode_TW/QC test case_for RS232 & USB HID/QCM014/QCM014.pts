'------------------------------------------------------------
' SCRIPT SETUP
' - Assign project name
'------------------------------------------------------------
Dim ProjectName
ProjectName = "QCM014" ' !!!!! EDIT THIS !!!!!
' Objective: check Timeout feature if Fallback to MSR transaction
'------------------------------------------------------------
DL.OpenProject ProjectName & ".ptp"
DL.ClearCommWindows 
DL.StartLogging "DOCKLIGHT_LOG",False, "H"
', false, true

Sub PrintMyResult(ResultX)
      If ResultX <> 0 Then
            MasterResult = 1
            DL.AddComment "Result = PASSED"
      Else
            MasterResult = 0
            DL.AddComment "Result = FAILED"
      End If
End Sub

Function ReverseResult(ResultParam)
      If ResultParam = 1 Then
            result = 0
      ElseIf ResultParam = 0 Then
            result = 1
      End If
End Function

Dim prompt
Dim confirm
max=1
min=0
Randomize
errCnt = 0
caseValid = 0

result = 1

DL.AddComment "TEST CASE: " & ProjectName & vbCrLf
'------------------------------------------------------------
'TEST BEGINS
'------------------------------------------------------------
sub podmode()
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Poll On Demand"
   DL.SendSequence "Poll On Demand"
   result = DL.WaitForSequence("01 00", 1, 1000)
   dl.pause 6000
end if
end sub

sub settags()
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Set tags DFEE20/ DFEE22"
   DL.SendSequence "Set tags DFEE20/ DFEE22"
   result = DL.WaitForSequence("60 00", 1, 1000)
end if
end sub

sub atmode()
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Quick Chip Mode"
   DL.SendSequence "Quick Chip Mode"
   result = DL.WaitForSequence("01 00", 1, 1000)
   dl.pause 8000
end if
end sub

sub ping()
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Ping"
   DL.SendSequence "Ping"
   result = DL.WaitForSequence("18 00", 1, 1000)
   dl.addcomment vbcrlf
end if
end sub

sub change2interface()
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Set transaction interface = CT+MSR"
   DL.SendSequence "Set transaction interface = CT+MSR"
   result = DL.WaitForSequence("04 00", 1, 1000)
end if
end sub

sub change3interface()
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Set transaction interface = ALL"
   DL.SendSequence "Set transaction interface = ALL"
   result = DL.WaitForSequence("04 00", 1, 1000)
end if
end sub
'------------------------------------------------------------
fail = 0

podmode()
settags()
atmode()
ping()

if result <> 0 then 
   dl.resetreceivecounter
   msgbox "Insert MSR card: the 1st time (remove card) --> Click OK", vbokonly
   result = DL.WaitForSequence("02 0A", 1, 1000)
   if result <> 0 then result = DL.WaitForSequence("DF EF 61 02 F2 50", 1, 200)
   if result = 0 then 
      DL.AddComment vbcrlf & "Output data: FAIL!!"
      fail = fail + 1
   end if

   dl.addcomment vbcrlf
   dl.resetreceivecounter
   msgbox "Insert MSR card: the 2nd time (remove card) --> Click OK", vbokonly
   result = DL.WaitForSequence("02 0A", 1, 1000)
   if result <> 0 then result = DL.WaitForSequence("DF EF 61 02 F2 50", 1, 200)
   if result = 0 then 
      DL.AddComment vbcrlf & "Output data: FAIL!!"
      fail = fail + 1
   end if

   dl.addcomment vbcrlf
   dl.resetreceivecounter
   msgbox "Insert MSR card: the 3rd time (remove card) --> Click OK", vbokonly
   result = DL.WaitForSequence("02 0A", 1, 1000)
   if result <> 0 then result = DL.WaitForSequence("DF EF 61 02 F2 22", 1, 200)
   if result = 0 then 
      DL.AddComment vbcrlf & "Output data: FAIL!!"
      fail = fail + 1
   end if

   dl.addcomment vbcrlf
   dl.resetreceivecounter
   DL.AddComment "Waiting for 1 min.........." 
   result = DL.WaitForSequence("02 08", 1, 61000)
   if result <> 0 then result = DL.WaitForSequence("DF EF 61 02 30 13", 1, 200)
   if result = 0 then 
      DL.AddComment vbcrlf & "Output data: FAIL!!"
      fail = fail + 1
   end if

   if fail = 0 then 
      ledcheck = msgbox("LED 3 is ON (flash status) if fallback to MSR reader, LED 3 is OFF if fallback timeout?", vbyesno)
      if ledcheck = 7 then 
         fail = fail + 1
         DL.AddComment vbcrlf & "LED behavior: FAIL!!"
      end if
   end if

   if fail <> 0 then result = 0
end if
'------------------------------------------------------------
DL.AddComment vbCrLf
DL.AddComment "---------- END OF TEST ----------" & vbCrLf
PrintMyResult(result)
