'------------------------------------------------------------
' SCRIPT SETUP
' - Assign project name
'------------------------------------------------------------
Dim ProjectName
ProjectName = "QCM001" ' !!!!! EDIT THIS !!!!!
' Objective: power off/ on reader, after send cmd, reader sent bluetooth signal data all the time
'------------------------------------------------------------
DL.OpenProject ProjectName & ".ptp"
DL.ClearCommWindows 
DL.StartLogging "DOCKLIGHT_LOG",False, "H"
', false, true

Sub PrintMyResult(ResultX)
      If ResultX <> 0 Then
            MasterResult = 1
            DL.AddComment "Result = PASSED"
      Else
            MasterResult = 0
            DL.AddComment "Result = FAILED"
      End If
End Sub

Function ReverseResult(ResultParam)
      If ResultParam = 1 Then
            result = 0
      ElseIf ResultParam = 0 Then
            result = 1
      End If
End Function

Dim prompt
Dim confirm
max=1
min=0
Randomize
errCnt = 0
caseValid = 0

result = 1

DL.AddComment "TEST CASE: " & ProjectName & vbCrLf
'------------------------------------------------------------
'TEST BEGINS
'------------------------------------------------------------
if result <> 0 then 
   dl.resetreceivecounter
   DL.AddComment "--- Poll On Demand"
   DL.SendSequence "Poll On Demand"
   result = DL.WaitForSequence("01 00", 1, 1000)
   dl.pause 6000
end if

if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Quick Chip Mode"
   DL.SendSequence "Quick Chip Mode"
   result = DL.WaitForSequence("01 00", 1, 1000)
   dl.pause 6000
end if
'------------------------------------------------------------
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Ping"
   DL.SendSequence "Ping"
   result = DL.WaitForSequence("18 00", 1, 1000)
end if

if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Wait"
   DL.AddComment vbcrlf & "Wait for 5 min......(to check if it output any strange data )"
   result = DL.WaitForSequence("any data", 1, 300000)
   ReverseResult(result)
end if
'------------------------------------------------------------
if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- 03-02"
   DL.SendSequence "03-02"
   result = DL.WaitForSequence("03 00", 1, 1000)
   dl.pause 200
end if

if result <> 0 then 
   dl.resetreceivecounter
   dl.addcomment vbcrlf
   DL.AddComment "--- Wait"
   DL.AddComment vbcrlf & "Wait for 5 min......(to check if it output any strange data )"
   result = DL.WaitForSequence("any data", 1, 300000)
   ReverseResult(result)
end if
'------------------------------------------------------------
DL.AddComment vbCrLf
DL.AddComment "---------- END OF TEST ----------" & vbCrLf
PrintMyResult(result)
